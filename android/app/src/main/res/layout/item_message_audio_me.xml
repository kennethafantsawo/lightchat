<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingStart="48dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:visibility="gone"
        android:background="@drawable/bg_reply"
        android:layout_marginBottom="3dp"
        android:maxWidth="@dimen/bubble_max_width">

        <com.lightchat.widget.EmojiTextView
            android:id="@+id/reply_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:maxWidth="280dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:padding="8dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            tools:text="↳ Reply" />
    </LinearLayout>

    <!-- Audio bubble — Telegram outgoing #EFFDDE with 18dp radius -->
    <LinearLayout
        android:id="@+id/msg_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:maxWidth="@dimen/bubble_max_width"
        android:minWidth="220dp"
        android:background="@drawable/bg_btn_primary"
        android:elevation="1dp"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Play button circle 40dp -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:elevation="0dp">

            <com.lightchat.widget.EmojiTextView
                android:id="@+id/btn_audio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:textColor="@color/on_primary"
                android:text="▶"
                android:textSize="18sp"
                android:includeFontPadding="false"
                tools:text="▶" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <com.lightchat.ui.WaveView
                android:id="@+id/wave"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.lightchat.widget.EmojiTextView
                    android:id="@+id/audio_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    android:alpha="0.9"
                    tools:text="0:12" />

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_online_dot"
                    android:alpha="0.5" />

                <com.lightchat.widget.EmojiTextView
                    android:id="@+id/audio_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="✓✓"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Duration inside bubble bottom-right fallback -->
        <com.lightchat.widget.EmojiTextView
            android:id="@+id/msg_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <com.lightchat.widget.EmojiTextView
        android:id="@+id/msg_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:visibility="gone"
        android:background="@drawable/bg_reply"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/on_surface"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:layout_marginTop="2dp">

        <com.lightchat.widget.EmojiTextView
            android:id="@+id/msg_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginEnd="6dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
