<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/pinned_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:background="@drawable/bg_chip_ripple">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pinned_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/pinned_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/disc_cancel"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/typing_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        android:background="@drawable/bg_chip_ripple"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/primary"
            android:contentDescription="@string/back" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/avatar_disc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#ffffffff"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar" />

            <View
                android:id="@+id/disc_online_dot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_presence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_disc_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:padding="4dp"
            android:visibility="gone"
            android:textColor="@color/error"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_search_disc"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/disc_search"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_mute"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/bell_on"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_ephemeral"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="\uD83D\uDD25"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ephemeral_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:background="@drawable/bg_chip_ripple" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/txt_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/msg_empty"
            android:textColor="@color/on_surface_variant"
            android:padding="24dp" />

        <ListView
            android:id="@+id/msg_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#00000000"
            android:dividerHeight="2dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/edit_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/edit_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/disc_cancel"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:padding="8dp"
        android:background="@drawable/bg_chip_ripple">

        <TextView
            android:id="@+id/selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="4dp"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sel_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/act_copy"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sel_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/act_forward"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sel_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/act_delete"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sel_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_ripple"
            android:text="@string/disc_cancel"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_ripple"
                android:text="@string/btn_plus"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/btn_emoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_ripple"
                android:text="@string/btn_emoji"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/btn_sticker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_ripple"
                android:text="@string/btn_sticker"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/btn_mic"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="48dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_chip_ripple"
                android:text="@string/btn_mic"
                android:textColor="@color/on_surface" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/msg_hint"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/send"
            android:background="@drawable/bg_btn_primary_ripple"
            android:textColor="@color/on_primary" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/emoji_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/emoji_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/sticker_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sticker_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>
</LinearLayout>