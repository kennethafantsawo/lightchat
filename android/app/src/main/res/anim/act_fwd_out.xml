<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:duration="200">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.5" />
    <translate android:fromXDelta="0" android:toXDelta="-6%" android:fromYDelta="0" android:toYDelta="0" />
    <scale android:fromXScale="1.0" android:toXScale="0.97"
        android:fromYScale="1.0" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="50%" />
</set>